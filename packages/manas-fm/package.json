{
  "name": "manas-fm",
  "version": "1.4.6",
  "description": "A file management package by M Anas for Node.js and Next.js applications",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "author": {
    "name": "M Anas Latif",
    "url": "https://m.anaslatif.dev",
    "email": "contact@anaslatif.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/manasdevs/file-manager.git"
  },
  "bugs": {
    "url": "https://github.com/manasdevs/file-manager/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run lint && pnpm run test && pnpm run build"
  },
  "keywords": [
    "file-management",
    "upload",
    "download",
    "nextjs",
    "typescript",
    "file-system",
    "versioning",
    "compression",
    "cloud-storage",
    "s3",
    "azure-blob",
    "gcs",
    "firebase-storage",
    "digitalocean-spaces",
    "backblaze-b2",
    "wasabi",
    "minio",
    "cloudflare-r2"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3.0.0",
    "@aws-sdk/lib-storage": ">=3.0.0",
    "@azure/storage-blob": ">=12.0.0",
    "firebase-admin": ">=11.0.0",
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/archiver": "^6.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "sharp": "^0.33.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}